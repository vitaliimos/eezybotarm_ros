<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="eezybotarm_ros2_control" params="name initial_positions_file use_mock_hardware i2c_bus i2c_address pwm_frequency">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_mock_hardware}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:unless value="${use_mock_hardware}">
                    <plugin>eezybotarm_hardware/EezyBotArmHardware</plugin>
                    <param name="i2c_bus">${i2c_bus}</param>
                    <param name="i2c_address">${i2c_address}</param>
                    <param name="pwm_frequency">${pwm_frequency}</param>
                </xacro:unless>
            </hardware>

            <joint name="waist_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['waist_joint']}</param>
                </state_interface>
                <param name="pca_channel">0</param>
                <param name="rad_min">-1.5708</param>
                <param name="rad_max">1.5708</param>
                <param name="us_min">600</param>
                <param name="us_max">2400</param>
                <param name="gear_ratio">2.0</param>
                <param name="invert_direction">true</param>
            </joint>
            <joint name="shoulder_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['shoulder_joint']}</param>
                </state_interface>
                <param name="pca_channel">1</param>
                <param name="rad_min">-1.5708</param>
                <param name="rad_max">1.5708</param>
                <param name="us_min">600</param>
                <param name="us_max">2400</param>
            </joint>
            <joint name="elbow_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['elbow_joint']}</param>
                </state_interface>
                <param name="pca_channel">2</param>
                <param name="rad_min">-1.5708</param>
                <param name="rad_max">1.5708</param>
                <param name="us_min">600</param>
                <param name="us_max">2400</param>
                <param name="invert_direction">true</param>
            </joint>
            <joint name="finger_left_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['finger_left_joint']}</param>
                </state_interface>
                <param name="pca_channel">3</param>
                <param name="rad_min">-1.5708</param>
                <param name="rad_max">1.5708</param>
                <param name="us_min">600</param>
                <param name="us_max">2400</param>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>