<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="environment" params="parent:=base_link">
    <xacro:property name="env_file" value="$(find eezybotarm_description)/config/environment.yaml" />
    <xacro:property name="env" value="${xacro.load_yaml(env_file)['/**']['ros__parameters']}" />

    <!-- Base Mounting Board (500 x 300 x 18 mm) -->
    <!-- Waist joint center is 63mm from the rear edge. Center X = -0.063 + 0.250 = +0.187 m -->
    <link name="base_board">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.500 0.300 0.018"/>
        </geometry>
        <material name="wood_pine">
          <color rgba="0.86 0.74 0.54 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.500 0.300 0.018"/>
        </geometry>
      </collision>
    </link>

    <joint name="${parent}_to_base_board" type="fixed">
      <parent link="${parent}"/>
      <child link="base_board"/>
      <origin xyz="0.187 0.0 -0.009" rpy="0 0 0"/>
    </joint>

    <!-- Work Table / Workspace (depth along X, width along Y, height along Z) -->
    <link name="work_table">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${env['table_depth_m']} ${env['table_width_m']} ${env['table_z_m']}"/>
        </geometry>
        <material name="table_surface">
          <color rgba="0.94 0.94 0.96 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${env['table_depth_m']} ${env['table_width_m']} ${env['table_z_m']}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${parent}_to_work_table" type="fixed">
      <parent link="${parent}"/>
      <child link="work_table"/>
      <origin xyz="${env['robot_x_offset_m'] + env['table_depth_m']/2.0} ${env.get('robot_y_offset_m', 0.0)} ${env['table_z_m']/2.0}" rpy="0 0 0"/>
    </joint>

    <!-- Camera Stand (height 300 mm, triangular base width 125 mm along front edge) -->
    <!-- Located at X = +0.390 m, Y = 0.0, Z center at +0.150 m -->
    <link name="camera_stand">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.300"/>
        </geometry>
        <material name="stand_green">
          <color rgba="0.15 0.30 0.15 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.300"/>
        </geometry>
      </collision>
    </link>

    <joint name="${parent}_to_camera_stand" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_stand"/>
      <origin xyz="0.390 0.0 0.150" rpy="0 0 0"/>
    </joint>

    <!-- Camera Body Link mounted on top of the stand (Z = +0.150 relative to stand center, i.e., Z = +0.300 m) -->
    <!-- Oriented towards -X (yaw = pi), pitched down ~56 degrees (0.9828 rad) towards the center of work table -->
    <link name="camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.020" length="0.060"/>
        </geometry>
        <material name="camera_body">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.025" length="0.070"/>
        </geometry>
      </collision>
    </link>

    <joint name="camera_stand_to_camera_link" type="fixed">
      <parent link="camera_stand"/>
      <child link="camera_link"/>
      <origin xyz="0.0 0.0 0.150" rpy="0.0 -0.9828 3.14159"/>
    </joint>

    <!-- Camera Optical Frame (ROS Standard: Z forward, X right, Y down) -->
    <link name="camera_optical_frame"/>

    <joint name="camera_link_to_optical" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    </joint>
  </xacro:macro>
</robot>
