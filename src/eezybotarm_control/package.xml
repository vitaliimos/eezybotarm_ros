<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eezybotarm_control</name>
  <version>0.0.0</version>
  <description>MoveIt 2 motion planning and pick-and-place action server for EezyBotArm</description>
  <maintainer email="mostipaka.vitalii@gmail.com">Vitalii Mostipaka</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_py</depend>
  <depend>geometry_msgs</depend>
  <depend>eezybotarm_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
