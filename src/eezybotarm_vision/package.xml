<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eezybotarm_vision</name>
  <version>0.0.0</version>
  <description>Computer vision and sorting coordination package for EezyBotArm</description>
  <maintainer email="mostipaka.vitalii@gmail.com">vitalii</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>
  <depend>eezybotarm_interfaces</depend>

  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>image_publisher</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
