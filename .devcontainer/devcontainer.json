{
    "name": "ROS 2 Lyrical Eezybotarm Dev",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "runArgs": [
        "--gpus", "all",
        "-v", "/dev:/dev",
        "--privileged",
        "--network=host",
        "--ipc=host"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "XDG_RUNTIME_DIR": "/tmp/runtime-ubuntu",
        "QT_X11_NO_MITSHM": "1",
        "QT_ENABLE_HIGHDPI_SCALING": "0",
        "QT_SCREEN_SCALE_FACTORS": "1",
        "OGRE_RTT_MODE": "Copy",
        "__GL_SYNC_TO_VBLANK": "0",
        "NVIDIA_VISIBLE_DEVICES": "all",
        "NVIDIA_DRIVER_CAPABILITIES": "graphics,compute,utility,display"
    },
    "initializeCommand": "xhost +si:localuser:root; xhost +si:localuser:$USER",
    "postCreateCommand": "true && (test -f /etc/ros/rosdep/sources.list.d/20-default.list || sudo rosdep init) && rosdep update && rosdep install --from-paths src --ignore-src -r -y || echo \"source /opt/ros/lyrical/setup.bash\" >> ~/.bashrc",
    "remoteUser": "ubuntu",
    "workspaceFolder": "/eezybot_ros",
    "workspaceMount": "source=${localWorkspaceFolder},target=/eezybot_ros,type=bind",
    "customizations": {
        "vscode": {
            "settings": {
                "python.autoComplete.extraPaths": [
                    "/opt/ros/lyrical/lib/python3.14/site-packages"
                ],
                "python.analysis.extraPaths": [
                    "/opt/ros/lyrical/lib/python3.14/site-packages"
                ],
                "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json"
            },
            "extensions": [
                "Ranch-Hand-Robotics.rde-pack",
                "ms-python.python",
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools"
            ]
        }
    }
}
